{
  "name": "bagz",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "BAGZ: live memecoin charts, Gem Radar and paper trading.",
  "scripts": {
    "dev": "vite --port 3000 --host 0.0.0.0",
    "build": "vite build",
    "build:single": "node build.mjs",
    "preview": "vite preview",
    "check": "tsc --noEmit -p tsconfig.check.json",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:browser": "node tests/browser.mjs",
    "vendor:charts": "node scripts/vendor-lwc.mjs",
    "test:e2e": "node tests/proxy-e2e.mjs",
    "test:app": "node --import tsx tests/app-e2e.ts",
    "test:telegram": "node tests/telegram-e2e.mjs",
    "test:cards": "node tests/cards-e2e.mjs",
    "test:social": "node --import tsx tests/social-e2e.ts",
    "test:copy": "node --import tsx tests/testcopy-e2e.ts",
    "build:copy": "BAGZ_DEMO=1 BAGZ_PAGE_OUT=docs/demo/index.html node build.mjs",
    "probe": "tsx scripts/probe-worker.ts"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "lightweight-charts": "4.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.24.0",
    "typescript": "~5.6.3",
    "vite": "^6.0.0",
    "tsx": "^4.19.0"
  }
}
